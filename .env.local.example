NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ENABLE_ACCOUNT_UI=true

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative when a new sb_secret key is unavailable:
SUPABASE_SERVICE_ROLE_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_API_KEY=
# Optional extra ownership check for a single Lemon Squeezy store.
LEMON_STORE_ID=

# Live Lemon Squeezy Product IDs, Variant IDs, and public checkout URLs are
# maintained together in lib/products/catalog.ts.
